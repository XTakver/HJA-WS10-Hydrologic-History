    given-names: Xander
    affiliation: "Oregon State University"
    email: xander.takver@oregonstate.edu
    orcid: "https://orcid.org/0009-0009-3320-2032"
  # Add any coauthors who contributed to the code, e.g.:
  # - family-names: Lastname
  #   given-names: Firstname
  #   affiliation: "Institution"
  #   orcid: "https://orcid.org/0000-0000-0000-0000"
keywords:
  - soil organic matter
  - FTICR-MS
  - hillslope hydrology
  - soil moisture
  - H.J. Andrews Experimental Forest
  - R
references:
  - type: article
    title: "Hydrologic History Drives Divergent Soil Organic Matter Trajectories Across Hillslopes"
    authors:
      - family-names: Takver
        given-names: Xander
